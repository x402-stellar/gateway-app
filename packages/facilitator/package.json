{
  "name": "@stellar-x402/facilitator",
  "version": "0.1.0",
  "description": "Gasless settlement relayer and fee sponsor for x402 on Stellar",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@stellar-x402/core": "workspace:*",
    "@stellar/stellar-sdk": "16.2.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.9.2",
    "vitest": "^2.1.4"
  }
}
